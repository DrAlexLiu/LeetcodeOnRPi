[Unit]
Description=VSCode kiosk (client of kiosk-frame; side alternates per boot)
After=kiosk-frame.service
BindsTo=kiosk-frame.service
ConditionKernelCommandLine=!kiosk=off
StartLimitIntervalSec=600
StartLimitBurst=15

[Service]
ExecStartPre=/usr/bin/python3 /etc/kiosk/wait-for-wayland.py
User=coder
PAMName=cage

Environment=WAYLAND_DISPLAY=/run/user/@FRAME_UID@/wayland-0
ExecStart=/bin/sh -c 'exec /usr/share/code/code --ozone-platform=wayland --wait --new-window @STUDY_DIR@ >>/var/log/kiosk/vscode.log 2>&1'
Restart=always
RestartSec=3
KillMode=control-group

[Install]
WantedBy=multi-user.target
